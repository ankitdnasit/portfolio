---
import Portfolio from '../components/Portfolio';
import '../index.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💻</text></svg>" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Optimization -->
    <title>Ankit Nasit | Senior Software Engineer — React Native & React</title>
    <meta name="description" content="Portfolio of Ankit Nasit, Senior Software Engineer with 7.5+ years of experience in React Native, React for web, Android, iOS, AI analytics, and fintech solutions. Based in Bangalore, India." />
    <meta name="keywords" content="Ankit Nasit, React Native Developer, Senior Software Engineer, React Engineer, Next.js, Bangalore, iOS Developer, Android Developer, Reliance JBIQ, Alrajhi Capital, Portfolio" />
    <meta name="author" content="Ankit Nasit" />

    <!-- Open Graph Metadata -->
    <meta property="og:title" content="Ankit Nasit | Senior Software Engineer — React Native & React" />
    <meta property="og:description" content="7.5+ years building cross-platform mobile & web applications for enterprise clients including Reliance and Al Rajhi Bank." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ankitdnasit.github.io/portfolio/" />
    <meta property="og:image" content="https://ankitdnasit.github.io/portfolio/og_preview.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Ankit Nasit | Senior Software Engineer — React Native & React" />
    <meta name="twitter:description" content="7.5+ years building cross-platform mobile & web applications for enterprise clients including Reliance and Al Rajhi Bank." />
    <meta name="twitter:image" content="https://ankitdnasit.github.io/portfolio/og_preview.png" />

    <!-- Google Fonts: Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <Portfolio client:load />
  </body>
</html>
